python3 - <<'PY'
import json
import os

account = os.environ["ACCOUNT_ID"]

policy = {
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowAuthorizedAccountPrincipals",
            "Effect": "Allow",
            "Principal": {
                "AWS": f"arn:aws:iam::{account}:root"
            },
            "Action": "sts:AssumeRole"
        }
    ]
}

with open("lab08-trust-policy.json", "w") as file:
    json.dump(policy, file, indent=2)
PY